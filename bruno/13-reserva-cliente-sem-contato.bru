meta {
  name: Reserva - Cliente sem contato (falha de consumo e DLT)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/reservas
  body: json
  auth: none
}

headers {
  X-Correlation-Id: bruno-dlt
}

body:json {
  {
    "clienteId": "44444444-4444-4444-4444-444444444444",
    "sessaoId": "22222222-2222-2222-2222-222222222222",
    "assentos": ["A1"],
    "simularRecusaPagamento": false,
    "simularFalhaIngresso": false
  }
}

script:pre-request {
  // Usa o primeiro assento livre da sessão: a coleção roda de novo sem zerar o ambiente.
  const axios = require('axios');
  const sessoes = (await axios.get(bru.getEnvVar('baseUrl') + '/api/sessoes')).data;
  const sessao = sessoes.find(s => s.id === '22222222-2222-2222-2222-222222222222');
  const corpo = req.getBody();
  corpo.assentos = [sessao.assentosDisponiveis[0]];
  req.setBody(corpo);
}

docs {
  A reserva é confirmada, mas o notificacao-service não acha o contato do cliente: cada evento
  falha 3 vezes e vai para cinepass.reserva.eventos.notificacao.DLT. Auditoria e reputação seguem
  normalmente. Depois, 14 cadastra o contato e 15 reprocessa a DLT.
  O cenário vale para o ambiente zerado (docker compose down -v): depois de cadastrado, o contato fica.
}
