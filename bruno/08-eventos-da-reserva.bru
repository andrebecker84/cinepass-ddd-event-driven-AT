meta {
  name: Eventos da reserva (outbox)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/reservas/{{reservaId}}/eventos
  body: none
  auth: none
}

script:post-response {
  // O eventId do ReservaConfirmada é o que a requisição 09 publica de novo (duplicata deliberada).
  const confirmada = (res.getBody() || []).find(e => e.eventType === 'ReservaConfirmada');
  if (confirmada) bru.setVar('eventId', confirmada.eventId);
}
